#!/bin/sh
# Wrapper around desktop/cmd/xtask (run `./xtask help` for commands).
# Works from any subdirectory while preserving the caller's cwd for relative path arguments.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -f "$root/desktop/go.mod" ]; then
    echo "xtask: cannot find desktop/go.mod beside $0" >&2
    exit 1
fi
# Under Git Bash on Windows, pass Windows-style paths (C:/...) to Go instead of MSYS paths (/c/...).
here() { pwd -W 2> /dev/null || pwd; }
RC2FX_XTASK_CWD=$(here)
RC2FX_XTASK_ROOT=$(cd -- "$root" && here)
export RC2FX_XTASK_ROOT RC2FX_XTASK_CWD
# Keep cgo off for xtask itself so cold starts don't compile e2fsprogs or goui-kit;
# subcommands that build the app re-enable cgo as needed.
CGO_ENABLED=0 exec go -C "$RC2FX_XTASK_ROOT/desktop" run ./cmd/xtask "$@"
