# Copy to .rc2fx-mixer.conf (git-ignored) and fill in. RC2FX_MIXER_* environment
# variables override these.
ip = 192.168.0.100
# user = root
# Private key and known_hosts file for the mixer, if not your SSH defaults.
# key = C:\Users\you\.ssh\rodecaster_ed25519
# known_hosts = C:\Users\you\.ssh\rodecaster_known_hosts
# The alias the app pinned the mixer's host key under (Settings > Developer).
# host_key_alias = rc2fx-0123456789ab
# Optional local hook run before mutating mixer commands (receives the action as
# $1 and RC2FX_MIXER_* connection variables; non-zero exit aborts the command).
# pre_command = ~/.local/bin/my-mixer-hook
